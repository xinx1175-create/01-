# 放到 /etc/systemd/system/flowmon.service，路径按实际安装位置改。
#   sudo systemctl daemon-reload && sudo systemctl enable --now flowmon
#   journalctl -u flowmon -f        看实时输出
[Unit]
Description=flowmon 资金流跟随策略 阶段一监控器
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=flowmon
WorkingDirectory=/opt/flowmon/src/monitor
ExecStart=/opt/flowmon/venv/bin/python -m flowmon run --config /opt/flowmon/config.toml
# 程序异常退出（不是正常停止）时推一条通知，然后 5 秒后自动拉起
ExecStopPost=/bin/sh -c 'if [ "$SERVICE_RESULT" != "success" ]; then /opt/flowmon/venv/bin/python -m flowmon notify --config /opt/flowmon/config.toml "异常退出" "result=$SERVICE_RESULT code=$EXIT_CODE status=$EXIT_STATUS，systemd 会自动重启"; fi'
Restart=always
RestartSec=5
# 正常停止：程序收到 SIGTERM 后落盘、保存状态再退出
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
